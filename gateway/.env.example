# Contoh environment untuk gateway service
LORA_GATEWAY_ID=GW001
LORA_API_TOKEN=ganti_dengan_token_gateway
LORA_SERVER_URL=https://lora-dev.apache.web.id/api/v1/telemetry
# Relatif OK jika dijalankan via ./run.sh atau systemd (WorkingDirectory=folder gateway)
LORA_BUFFER_DB=./gateway_buffer.db
LORA_RETRY_INTERVAL=5
LORA_REQUEST_TIMEOUT=10
