[Unit]
Description=LoRa SX1276 Gateway (nodesensor -> buffer -> Laravel API)
Documentation=file://__GATEWAY_DIR__/gateway.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Diisi otomatis oleh install_service.sh
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
SupplementaryGroups=gpio spi
WorkingDirectory=__GATEWAY_DIR__
EnvironmentFile=__GATEWAY_DIR__/.env
ExecStart=__GATEWAY_DIR__/.venv/bin/python __GATEWAY_DIR__/gateway.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# Log ke journald: journalctl -u lora-gateway -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lora-gateway

# Jangan escalate privilege tak perlu; SPI/GPIO lewat group gpio/spi
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
